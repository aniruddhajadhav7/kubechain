# KubeChain Environment Configuration Template
# Copy to .env for local development

# ==============================================================================
# GATEWAY SETTINGS
# ==============================================================================
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_DEBUG=false
GATEWAY_LOG_LEVEL=INFO

# Chain Configuration
CHAIN_ID=31337
CHAIN_NAME=local-anvil
CHAIN_NETWORK=anvil-dev

# Gateway Upstream Routing
# Comma-separated list of backend URLs
UPSTREAM_BACKEND_URLS=http://localhost:8545
UPSTREAM_TIMEOUT_SECONDS=5.0
UPSTREAM_MAX_RETRIES=2
UPSTREAM_MAX_CONNECTIONS=100
UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=20

# Health Monitoring
HEALTH_PROBE_INTERVAL_SECONDS=5.0
HEALTH_PROBE_TIMEOUT_SECONDS=2.0
HEALTH_MAX_BLOCK_LAG=5

# ==============================================================================
# AUTHENTICATION & RATE LIMITING
# ==============================================================================
AUTH_ENABLED=true
# Comma-separated list of authorized API keys for local dev
# In production, keys must be provisioned hashed into Redis
AUTH_API_KEYS=kc_dev_secret_key_1,kc_dev_secret_key_2

RATE_LIMIT_ENABLED=true
RATE_LIMIT_COMPUTE_UNITS_PER_SECOND=100
RATE_LIMIT_BURST_CAPACITY=200

# ==============================================================================
# REDIS CACHE
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TIMEOUT_SECONDS=1.0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_FINALIZED_TTL_SECONDS=86400

# ==============================================================================
# OPERATOR SETTINGS
# ==============================================================================
OPERATOR_NAMESPACE=default
OPERATOR_LOG_LEVEL=INFO
OPERATOR_RECONCILE_INTERVAL_SECONDS=30

# ==============================================================================
# OBSERVABILITY
# ==============================================================================
METRICS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=kubechain-gateway
OTEL_TRACES_ENABLED=false
